# TOS 7 §4.6: every script and config file shipped to the NAS MUST use LF.
# Mark them explicitly so a Windows checkout cannot reintroduce CRLF.
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.ini       text eol=lf
*.lang      text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.env       text eol=lf
control     text eol=lf
postinst    text eol=lf
prerm       text eol=lf
postrm      text eol=lf
preinst     text eol=lf

*.deb       binary
*.bz2       binary
*.png       binary
*.jpg       binary
*.woff2     binary
