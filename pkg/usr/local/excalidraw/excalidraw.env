# Excalidraw Environment Configuration
# Platform contract: back end listens on the Unix socket /var/api/excalidraw.sock

# Application identity
APP_ID=excalidraw
APP_ROOT=/usr/local/excalidraw
APP_VERSION=1.0.0

# Web UI and code paths
WEBUI_DIR=/usr/local/excalidraw/webui
PYTHONPATH=/usr/local/excalidraw/lib

# Runtime data (regenerated as needed, safe to delete)
CONFIG_DATA=/usr/local/excalidraw/data
DATA_LOG=/usr/local/excalidraw/logs

# Logging: DEBUG / INFO / WARN / ERROR (DEBUG must stay off in production)
LOG_LEVEL=INFO

# Optional collaboration backend (excalidraw-room). Empty = local-only mode.
COLLAB_URL=
