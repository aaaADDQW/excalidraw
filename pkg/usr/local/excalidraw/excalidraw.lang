descript = "手繪風格白板，用於繪製示意圖、流程圖和隨手塗鴉。所有繪圖資料都保存在本機 NAS 上，不對外傳送。"
release_note = "1.0.0：首個版本，基於 Excalidraw 官方 Web 建置打包，支援繪圖、匯出 PNG/SVG、深色模式，可離線使用。"
important = "繪圖內容保存在瀏覽器本地儲存中，清除瀏覽器資料會遺失，重要內容請及時匯出為檔案。"

[en-us]
name = "Excalidraw"
auth = "TerraMaster Community"
descript = "Hand-drawn style whiteboard for sketching diagrams, flowcharts and ideas. All drawings stay on your NAS and are never sent out."
release_note = "1.0.0: first release, packaged from the official Excalidraw web build. Supports drawing, PNG/SVG export and dark mode; works fully offline."
important = "Drawings are kept in browser local storage. Clearing browser data will remove them, so export important work to a file."

[fr-fr]
name = "Excalidraw"
