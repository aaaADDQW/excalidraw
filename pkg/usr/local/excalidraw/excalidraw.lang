[zh-cn]
name = "Excalidraw 白板"
auth = "TerraMaster Community"
descript = "手绘风格白板，用于绘制示意图、流程图和随手涂鸦。所有绘图数据都保存在本机 NAS 上，不对外发送。"
release_note = "1.0.0：首个版本，基于 Excalidraw 官方 Web 构建打包，支持绘图、导出 PNG/SVG、深色模式，可离线使用。"
important = "绘图内容保存在浏览器本地存储中，清除浏览器数据会丢失，重要内容请及时导出为文件。"

[zh-hk]
