descript = "Tableau blanc au style dessine a la main pour schemas, organigrammes et idees. Tous les dessins restent sur votre NAS."
release_note = "1.0.0 : premiere version, construite a partir du build web officiel d'Excalidraw. Dessin, export PNG/SVG et mode sombre, fonctionne hors ligne."
